// ─────────────────────────────────────────────────────────────────
// INCO Firestore Security Rules — Pass A  (THE LIVE RULESET)
//
// This file is what `firebase deploy --only firestore:rules` ships and
// must always mirror production.  The role-aware Pass B rules live in
// firestore.passB.rules and are NOT deployed: they depend on the
// partner_index lookup table, which is not populated yet — deploying
// Pass B today would lock every partner out.
//
// Any NEW collection the app writes must get a match block here,
// otherwise the default-deny at the bottom rejects it (and a batch that
// includes it fails as a whole).
// Pass A locks every read and write behind Firebase Auth. With these
// rules in effect, leaking the API key (which is unavoidable for any
// browser-based Firebase app) does not give an attacker any access:
// they can hit Firestore with the key all day long, but every request
// without a valid signed-in user is rejected.
//
// A few notes:
//   - All your team uses the same access level (per the project plan),
//     so we don't separate admin/staff yet. When you want roles in
//     Pass B, switch the helper below to check custom claims.
//   - Schema validation is intentionally light here: it catches
//     obviously malformed writes (wrong types on critical fields) but
//     does not try to enforce every business rule — those live in the
//     app and would require very long, brittle rules.
//   - `_saveStamp` is the optimistic-lock counter the v10 konfig save
//     transaction uses; we just check it's a number when present.
// ─────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── Helpers ─────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // True when the (incoming, after-write) document field `f` is either
    // missing, null, or a number. Used for legacy docs that may not yet
    // carry _saveStamp.
    function optionalNumber(f) {
      return !(f in request.resource.data)
          || request.resource.data[f] == null
          || request.resource.data[f] is number;
    }

    // ───── Konfigurim (4 fixed docs) ──────────────────────────────
    // Only `global`, `formats`, `materials`, `tenies` should ever exist
    // under /konfig. Reject any other doc id outright.
    match /konfig/{docId} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && docId in ['global', 'formats', 'materials', 'tenies']
                   && optionalNumber('_saveStamp');
    }

    // ───── Klientët ───────────────────────────────────────────────
    match /klientet/{klientId} {
      allow read, write: if signedIn();
    }

    // ───── Porosite (full order docs) ─────────────────────────────
    match /porosite/{orderId} {
      allow read, write: if signedIn();
    }

    // ───── Porosite index (summary docs used by the order list) ──
    match /porosite_index/{orderId} {
      allow read, write: if signedIn();
    }

    // ───── Kanban state per order ─────────────────────────────────
    match /kanban/{orderId} {
      allow read, write: if signedIn();
    }

    // ───── Counters (sequential ID allocators) ────────────────────
    // counters/porosite — global next-order-id
    // counters/fatura_{klientId} — per-client fatura allocator
    match /counters/{counterId} {
      allow read, write: if signedIn();
    }

    // ───── Porosite trash (soft-deleted orders) ───────────────────
    // deleteOrderById / klient cascade MOVE the order here in the same
    // batch as the delete; the admin "Koshi" modal restores or purges.
    // Without this match the default-deny rejected the whole batch, so
    // order deletion itself failed.
    match /porosite_trash/{orderId} {
      allow read, write: if signedIn();
    }

    // ───── Paint time tracking (Lyerje) ───────────────────────────
    // One doc per work interval of a paint step on one order section.
    // Append-only by convention (edits/deletes are audited in-doc).
    match /paint_sessions/{sessionId} {
      allow read, write: if signedIn();
    }

    // ───── Workers (shop personnel picked on paint sessions) ──────
    match /workers/{workerId} {
      allow read, write: if signedIn();
    }

    // ───── Default deny ─────────────────────────��─────────────────
    // Anything not matched above is denied. This is the firewall: if
    // someone discovers a different collection name, they still can't
    // touch it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
