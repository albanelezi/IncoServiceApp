{
  "hosting": {
    "site": "incoservice-4e196",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      "**/node_modules/**",
      "functions/**",
      "bundle-worker.js",
      "optimizer-worker.min.js",
      "optimizer-worker.obf.js",
      "INCO_Furniture_v12.src.html",
      "*.rules",
      "README.md",
      "*.zip",
      "*.bak",
      "_*.js",
      "**/*_WINCUT/**",
      "**/*.txt",
      "**/*.md",
      "handover-tools/**"
    ],
    "headers": [
      {
        "source": "/optimizer-worker.js",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "https://inco-oferta.web.app" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      { "source": "**", "destination": "/INCO_Furniture_v12.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "_*.js",
        "test-*.js",
        "verify-*.js"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
